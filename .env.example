# Copia este archivo como .env y rellena tus datos.

# Contraseña para entrar en MiPuter (si la dejas vacía, no se pide contraseña).
MIPUTER_PASSWORD=pon-aqui-una-contraseña-larga

# --- Backblaze B2 ---
# Panel de B2 → "Application Keys" → "Add a New Application Key"
# (dale acceso de lectura y escritura solo al bucket que vayas a usar).

B2_KEY_ID=tu_keyID
B2_APPLICATION_KEY=tu_applicationKey
B2_BUCKET=nombre-de-tu-bucket
# Panel de B2 → Buckets → "Endpoint" (p. ej. s3.us-west-004.backblazeb2.com)
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com

# Opcional
# B2_PREFIX=miputer      # carpeta dentro del bucket
# MAX_UPLOAD_MB=100      # tamaño máximo por archivo
# PORT=8000
# SESSION_DAYS=30        # días que dura la sesión iniciada
# COOKIE_SECURE=true     # fuerza la cookie "Secure" (si publicas con HTTPS)
# TRUST_PROXY=true       # si va detrás de un proxy (nginx, Caddy…), para limitar intentos por IP real
